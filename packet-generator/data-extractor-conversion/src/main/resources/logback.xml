	<appender name="BATCH_SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">

		<discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
			<Key>logType</Key>
			<DefaultValue>migrator</DefaultValue>
		</discriminator>

		<sift>
			<appender name="FILE-${logType}"
					  class="ch.qos.logback.core.rolling.RollingFileAppender">

				<file>${APP_LOG_ROOT}/${logType}.log</file>

				<encoder>
					<pattern>${LOG_PATTERN}</pattern>
				</encoder>

				<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
					<fileNamePattern>${APP_LOG_ROOT}/${logType}-%i.log</fileNamePattern>
					<minIndex>1</minIndex>
					<maxIndex>20</maxIndex>
				</rollingPolicy>

				<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
					<maxFileSize>100MB</maxFileSize>
				</triggeringPolicy>

			</appender>
		</sift>
	</appender>

	<!-- Error-only log -->
	<appender name="errorLog" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${APP_LOG_ROOT}/migrator-error.log</file>
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>ERROR</level>
			<onMatch>ACCEPT</onMatch>
			<onMismatch>DENY</onMismatch>
		</filter>
		<encoder>
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
		<rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
			<fileNamePattern>${APP_LOG_ROOT}/migrator-error-%i.log</fileNamePattern>
			<minIndex>1</minIndex>
			<maxIndex>10</maxIndex>
		</rollingPolicy>
		<triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
			<maxFileSize>100MB</maxFileSize>
		</triggeringPolicy>
	</appender>

	<!-- Spring Batch logs
	<logger name="org.springframework.batch" level="INFO" additivity="false">
		<appender-ref ref="batchLog"/>
	</logger>-->

	<root level="INFO">
		<appender-ref ref="errorLog"/>
		<appender-ref ref="BATCH_SIFT"/>
	</root>
</configuration>